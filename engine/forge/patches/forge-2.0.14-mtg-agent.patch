--- /dev/null
+++ b/forge-gui-desktop/src/test/java/forge/ai/WeSayTheeNayTest.java
@@ -0,0 +1,100 @@
+package forge.ai;
+
+import forge.game.Game;
+import forge.game.GameActionUtil;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.player.Player;
+import forge.game.spellability.OptionalCost;
+import forge.game.spellability.OptionalCostValue;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import org.testng.AssertJUnit;
+import org.testng.annotations.Test;
+
+import java.io.ByteArrayOutputStream;
+import java.io.PrintStream;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.stream.Collectors;
+
+public class WeSayTheeNayTest extends AITest {
+    @Test
+    public void testNormalCastWhenOpponentCannotPay() {
+        runCounterScenario(false, 0, false);
+    }
+
+    @Test
+    public void testNormalCastWhenOpponentCanPay() {
+        runCounterScenario(false, 2, true);
+    }
+
+    @Test
+    public void testTeamworkCastWhenOpponentCannotPay() {
+        runCounterScenario(true, 2, false);
+    }
+
+    @Test
+    public void testTeamworkCastWhenOpponentCanPay() {
+        runCounterScenario(true, 4, true);
+    }
+
+    private void runCounterScenario(boolean teamwork, int opponentMana, boolean targetResolves) {
+        Game game = initAndCreateGame();
+        Player caster = game.getPlayers().get(1);
+        caster.setTeam(0);
+        Player opponent = game.getPlayers().get(0);
+        opponent.setTeam(1);
+
+        addCards("Island", 2, caster);
+        Card teamworkCreature = addCard("Runeclaw Bear", caster);
+        addCards("Island", opponentMana, opponent);
+        fillLibrary(opponent, 10);
+
+        Card targetCard = addCardToZone("Tidings", opponent, ZoneType.Hand);
+        SpellAbility target = targetCard.getSpells().get(0);
+        target.setActivatingPlayer(opponent);
+        game.getStack().freezeStack(target);
+        target.setHostCard(game.getAction().moveToStack(targetCard, target));
+        game.getStack().addAndUnfreeze(target);
+
+        Card counterCard = addCardToZone("We Say Thee Nay!", caster, ZoneType.Hand);
+        SpellAbility counter = counterCard.getSpells().get(0);
+        counter.setActivatingPlayer(caster);
+        if (teamwork) {
+            List<OptionalCostValue> teamworkCost = GameActionUtil.getOptionalCostValues(counter)
+                    .stream()
+                    .filter(value -> value.getType() == OptionalCost.Teamwork)
+                    .collect(Collectors.toList());
+            AssertJUnit.assertEquals(1, teamworkCost.size());
+            counter = GameActionUtil.addOptionalCosts(counter, teamworkCost);
+            counter.setActivatingPlayer(caster);
+        }
+        counter.getTargets().add(target);
+
+        ByteArrayOutputStream capturedError = new ByteArrayOutputStream();
+        PrintStream originalError = System.err;
+        try {
+            System.setErr(new PrintStream(capturedError, true, StandardCharsets.UTF_8.name()));
+            if (teamwork) {
+                AssertJUnit.assertTrue(ComputerUtilCost.checkTapTypeCost(
+                        caster,
+                        counter.getPayCosts(),
+                        counterCard,
+                        counter,
+                        new CardCollection()));
+            }
+            AssertJUnit.assertTrue(ComputerUtil.handlePlayingSpellAbility(caster, counter, null));
+            playUntilStackClear(game);
+        } catch (Exception exception) {
+            throw new RuntimeException(exception);
+        } finally {
+            System.setErr(originalError);
+        }
+
+        AssertJUnit.assertFalse(capturedError.toString(StandardCharsets.UTF_8)
+                .contains("SVar 'Any'"));
+        AssertJUnit.assertEquals(targetResolves ? 4 : 0, opponent.getCardsIn(ZoneType.Hand).size());
+        AssertJUnit.assertEquals(teamwork, teamworkCreature.isTapped());
+    }
+}
